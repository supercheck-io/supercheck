    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "e2e": "cd e2e && npx playwright test",
    "e2e:ui": "cd e2e && npx playwright test --ui",
    "e2e:headed": "cd e2e && npx playwright test --headed",
    "e2e:debug": "cd e2e && npx playwright test --debug",
    "e2e:report": "cd e2e && npx playwright show-report",
    "e2e:install": "cd e2e && npm install && npx playwright install --with-deps",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "db:studio": "drizzle-kit studio",
    "db:migrate:prod": "node scripts/db-migrate.js",
    "setup:admin": "node scripts/bootstrap-admin.js",
    "revoke:admin": "node scripts/revoke-admin.js",
    "predev": "node scripts/generate-playwright-types.js",
    "prebuild": "node scripts/generate-playwright-types.js",
    "prebuild:webpack": "node scripts/generate-playwright-types.js"
  },
