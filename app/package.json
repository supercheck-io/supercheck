    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:db": "jest -c jest.db.config.js",
    "test:sre-eval": "jest src/sre/eval",
