        "label": "Run admission",
        "focus": [
          "you",
          "api",
          "redis",
          "queue"
        ],
        "note": "Redis Lua reserves capacity per organization; full queues reject or park the run until a slot frees."
      },
      {
        "id": "sandboxed-execution",
        "label": "Sandboxed execution",
        "focus": [
          "worker",
          "sandbox",
          "store"
        ],
        "note": "The worker turns the run into a gVisor Job, captures the outcome, and stores reports and usage."
      },
      {
        "id": "live-status-and-cancel",
        "label": "Cancel flow",
        "focus": [
          "queue",
          "api",
          "you",
          "redis",
          "worker",
          "sandbox"
        ],
        "note": "Queue events feed SSE updates; cancellation writes a Redis signal the worker polls to delete the Job."
      }
    ]
