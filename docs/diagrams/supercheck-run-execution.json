  "cards": [
    {
      "dot": "cyan",
      "title": "Admission control",
      "items": [
        "Redis Lua reserves running and queued capacity per organization",
        "Runs start, wait in FIFO order, or are rejected when full",
        "A promoter retries queued runs every 5 seconds; errors fail closed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Isolated execution",
      "items": [
        "Each run becomes a gVisor Job in supercheck-execution",
        "Scripts arrive through Job-owned Secrets; no service account token",
        "Reports, screenshots, and traces land in S3 or R2"
      ]
    },
    {
      "dot": "orange",
      "title": "Status recovery",
      "items": [
        "Queue events stream to the UI over SSE",
        "3 attempts with backoff; stalled runs recovered after about 80 minutes",
        "Cancellation deletes the Job and records an error"
      ]
    }
  ],
