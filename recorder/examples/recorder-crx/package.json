{
  "name": "supercheck-recorder",
  "version": "1.0.2",
  "description": "Supercheck Recorder - Record browser interactions as Playwright code",
  "type": "module",
  "keywords": [
    "supercheck",
    "playwright",
    "recorder",
    "chrome-extension",
    "testing"
  ],
  "author": "Supercheck",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/supercheck-io/supercheck.git",
    "directory": "recorder/examples/recorder-crx"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npx tsc && npx vite build && npx vite build --config vite.content-script.config.ts",
    "lint": "npx eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "playwright-crx": "0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal-promise": "^1.0.2",
    "web": "file:../../playwright/packages/web",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/codemirror": "^5.60.15",
    "@types/node": "^18.19.68",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
